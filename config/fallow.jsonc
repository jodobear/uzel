{
  "$schema": "https://raw.githubusercontent.com/AdrianGonz97/fallow/main/schema.json",
  "entry": [
    "scripts/check-napplet-imports.mjs"
  ],
  "rules": {
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "unused-files": "error",
    "unused-dependencies": "error"
  },
  "ignoreUnresolvedImports": [
    "/trusted-shell/trusted-shell-policy.js",
    "/trusted-shell/trusted-shell-prelude-domains.js",
    "/trusted-shell/trusted-shell.js",
    "/trusted-shell/trusted-shell-surface-host.js"
  ],
  "ignoreDependencies": [
    "@napplet/cli"
  ],
  "ignorePatterns": [
    "graphify-out/**",
    "uzel-poc-validated-pack/**",
    "apps/uzel/public/trusted-shell/**",
    "**/dist/**",
    "**/target/**"
  ]
}
