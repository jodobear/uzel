{
  // Validated by Work 00 against signed Fallow 3.9.1. The released schema
  // uses ignorePatterns; the original starter field "ignore" was rejected.
  "audit": { "gate": "new-only" },
  "rules": {
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "unused-files": "error",
    "unused-dependencies": "error"
  },
  "ignorePatterns": ["**/generated/**", "**/dist/**", "**/target/**"]
}
